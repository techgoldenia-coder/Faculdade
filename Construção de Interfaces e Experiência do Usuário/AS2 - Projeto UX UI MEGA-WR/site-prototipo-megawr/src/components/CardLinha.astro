---
import { Image } from 'astro:assets';

interface Props {
  titulo: string;
  descricao: string;
  /* ImageMetadata (e nao string) porque a imagem vem importada de src/assets:
     e' o que deixa o Astro gerar webp e srcset no build. */
  imagem?: ImageMetadata;
  itens: string[];
  /* Sem foto, o card cai num bloco tipografico com hairline na cor da marca.
     Trocar por foto real assim que houver sessao das linhas Saude e Fitness. */
  acento?: string;
  /* Link do orcamento com a linha ja selecionada (proposta da AS2). */
  href?: string;
}

const { titulo, descricao, itens, imagem, acento = 'var(--azul)', href } = Astro.props;

// Grid de 3 colunas em 1152px de conteudo (gap 24) => ~368px por card.
// Quebra para 2 colunas em 996px e para 1 coluna em 672px.
const sizes =
  '(max-width: 672px) calc(100vw - 48px), (max-width: 996px) calc((100vw - 72px) / 2), 368px';
---

<article class="card">
  {
    imagem ? (
      <div class="foto">
        <Image
          src={imagem}
          alt={`Uniformes da linha ${titulo} produzidos pela MEGA-WR Confecções`}
          widths={[400, 600, 800, 1200]}
          sizes={sizes}
          loading="lazy"
        />
      </div>
    ) : (
      <div class="foto vazia" style={`--acento: ${acento}`} aria-hidden="true" />
    )
  }

  <div class="corpo">
    <h3>{titulo}</h3>
    <p>{descricao}</p>
    <ul>
      {itens.map((i) => <li>{i}</li>)}
    </ul>
    {href && (
      <a class="btn btn-ghost orcar" href={href}>
        Orçar linha {titulo} <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }

  .foto {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.05);
    transition: transform 0.6s var(--ease);
  }

  .card:hover .foto img {
    transform: scale(1.03);
  }

  .vazia {
    background: linear-gradient(160deg, #262626, #141414);
    border-bottom: 2px solid var(--acento);
  }

  .corpo {
    padding: 28px;
  }

  .corpo p {
    margin: 12px 0 0;
    font-size: 15px;
  }

  ul {
    list-style: none;
    margin: 24px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--graphite);
    font-size: 14px;
    color: var(--smoke);
  }

  li + li {
    margin-top: 8px;
  }

  .orcar {
    margin-top: 24px;
    width: 100%;
    justify-content: center;
  }
</style>
